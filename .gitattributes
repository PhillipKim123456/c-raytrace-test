# Keep source and documentation consistent across Windows editors and Git.
* text=auto
*.c text eol=lf
*.h text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
Makefile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
LICENSE text eol=lf

*.exe binary
*.png binary
*.jpg binary
*.ppm binary
